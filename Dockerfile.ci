# syntax=docker/dockerfile:1.7

ARG NGINX_FROM_IMAGE=nginx:mainline-alpine-slim

FROM ${NGINX_FROM_IMAGE} AS nginx-module-builder

ARG ENABLED_MODULES=brotli

SHELL ["/bin/ash", "-exo", "pipefail", "-c"]

RUN test -n "$ENABLED_MODULES"

RUN mkdir -p /modules /tmp/packages \
    && apk add --no-cache \
        abuild \
        coreutils \
        curl \
        g++ \
        gcc \
        git \
        libxml2-utils \
        libxslt \
        linux-headers \
        make \
        musl-dev \
        openssl \
        openssl-dev \
        pcre2-dev \
        unzip \
        xz \
        zlib-dev \
    && printf '#!/bin/sh\nSETFATTR=true /usr/bin/abuild -F "$@"\n' > /usr/local/bin/abuild \
    && chmod +x /usr/local/bin/abuild \
    && git clone -b "${NGINX_VERSION}-${PKG_RELEASE}" https://github.com/nginx/pkg-oss/ /pkg-oss \
    && for module in $ENABLED_MODULES; do \
        echo "Building $module for nginx-$NGINX_VERSION"; \
        if [ -d "/modules/$module" ]; then \
            test -s "/modules/$module/source"; \
            if [ -f "/modules/$module/build-deps" ]; then \
                apk add --no-cache $(xargs < "/modules/$module/build-deps"); \
            fi; \
            if [ -x "/modules/$module/prebuild" ]; then \
                "/modules/$module/prebuild"; \
            fi; \
            /pkg-oss/build_module.sh \
                -v "$NGINX_VERSION" \
                -f \
                -y \
                -o /tmp/packages \
                -n "$module" \
                $(cat "/modules/$module/source"); \
            normalized_module=$(echo "$module" | tr '[:upper:]' '[:lower:]' | tr -d '[/_.[:space:]-]'); \
            BUILT_MODULES="$BUILT_MODULES $normalized_module"; \
        elif make -C /pkg-oss/alpine list | grep -E "^$module[[:space:]]+[0-9]+" > /dev/null; then \
            cd /pkg-oss/alpine; \
            make "abuild-module-$module" BASE_VERSION="$NGINX_VERSION" NGINX_VERSION="$NGINX_VERSION"; \
            apk add --no-cache $(. "./abuild-module-$module/APKBUILD"; echo "$makedepends"); \
            make "module-$module" BASE_VERSION="$NGINX_VERSION" NGINX_VERSION="$NGINX_VERSION"; \
            find /root/packages -type f -name '*.apk' -exec mv -v {} /tmp/packages/ \;; \
            BUILT_MODULES="$BUILT_MODULES $module"; \
        else \
            echo "Unknown nginx module: $module" >&2; \
            exit 1; \
        fi; \
    done \
    && printf 'BUILT_MODULES="%s"\n' "$BUILT_MODULES" > /tmp/packages/modules.env

FROM ${NGINX_FROM_IMAGE} AS nginx-runtime

RUN --mount=type=bind,target=/tmp/packages,source=/tmp/packages,from=nginx-module-builder \
    . /tmp/packages/modules.env \
    && for module in $BUILT_MODULES; do \
        apk add --no-cache --allow-untrusted /tmp/packages/nginx-module-${module}-${NGINX_VERSION}*.apk; \
    done \
    && apk add --no-cache wget \
    && test -x /bin/sh \
    && command -v wget

FROM oven/bun:1.3.11-alpine AS dependencies

WORKDIR /usr/src/app

COPY patches/ ./patches/
COPY scripts/ ./scripts/
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

FROM dependencies AS test

COPY . .
RUN bun run check \
    && bun run test

FROM test AS build

ARG VITE_MODE=production
ENV NODE_ENV=production

RUN --mount=type=secret,id=web_build_env,target=/usr/src/app/.env.local,required=true \
    --mount=type=secret,id=sentry_auth_token,target=/run/secrets/sentry_auth_token \
    case "$VITE_MODE" in \
        development|staging|production) ;; \
        *) echo "Unsupported Vite mode: $VITE_MODE" >&2; exit 2 ;; \
    esac \
    && if [ -s /run/secrets/sentry_auth_token ]; then \
        export SENTRY_AUTH_TOKEN="$(cat /run/secrets/sentry_auth_token)"; \
        export SENTRY_UPLOAD_SOURCEMAPS=true; \
    fi \
    && bun run build --mode "$VITE_MODE" \
    && find dist -type f -name '*.map' -delete

FROM nginx-runtime AS final

COPY nginx.conf /etc/nginx/nginx.conf
COPY --from=build /usr/src/app/dist/ /usr/share/nginx/html/

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://127.0.0.1/ || exit 1
